= restaurantData.table_menu_list || []\n    const activeCategory = menuList.find(\n      cat => cat.menu_category_id === activeCategoryId,\n    )\n    const dishes = activeCategory ? activeCategory.category_dishes : []\n\n    return (\n      <ul className='dishes-list'>\n        {dishes.map(dish => (\n          <DishItem key={dish.dish_id} dishDetails={dish} />\n        ))}\n      </ul>\n    )\n  }\n\n  render() {\n    const {isLoading, restaurantData} = this.state\n\n    if (isLoading) {\n      return (\n        <div className='loader-container'>\n          <div className='spinner' />\n          <p className='loading-text'>Preparing your menu...</p>\n        </div>\n      )\n    }\n\n    return (\n      <div className='home-container'>\n        <Header restaurantName={restaurantData.restaurant_name} />\n        <div className='hero-banner'>\n          <h2 className='hero-title'>Delicious Meals Prepared Fresh</h2>\n          <p className='hero-subtitle'>\n            Order your favorite dishes and have them delivered warm & fast\n          </p>\n        </div>\n        {this.renderCategories()}\n        {this.renderDishes()}\n      </div>\n    )\n  }\n}\n\nexport default Home\n","import {AiFillCloseCircle} from 'react-icons/ai'\nimport CartContext from '../../context/CartContext'\nimport './index.css'\n\nconst CartItem = ({cartItemDetails}) => (\n  <CartContext.Consumer>\n    {value => {\n      const {\n        incrementCartItemQuantity,\n        decrementCartItemQuantity,\n        removeCartItem,\n      } = value\n\n      const {\n        dish_id: dishId,\n        dish_name: dishName,\n        dish_image: dishImage,\n        dish_currency: dishCurrency,\n        dish_price: dishPrice,\n        quantity,\n      } = cartItemDetails\n\n      const onIncrement = () => incrementCartItemQuantity(dishId)\n      const onDecrement = () => decrementCartItemQuantity(dishId)\n      const onRemove = () => removeCartItem(dishId)\n\n      const totalItemPrice = dishPrice * quantity\n\n      return (\n        <li className='cart-item'>\n          <img className='cart-item-image' src={dishImage} alt={dishName} />\n          <div className='cart-item-details-container'>\n            <p className='cart-item-title'>{dishName}</p>\n            <div className='cart-quantity-container'>\n              <button\n                type='button'\n                className='cart-qty-btn'\n                onClick={onDecrement}\n              >\n                -\n              </button>\n              <p className='cart-qty-value'>{quantity}</p>\n              <button\n                type='button'\n                className='cart-qty-btn'\n                onClick={onIncrement}\n              >\n                +\n              </button>\n            </div>\n            <p className='cart-item-price'>\n              {dishCurrency} {totalItemPrice.toFixed(2)}\n            </p>\n          </div>\n          <button type='button' className='cart-remove-btn' onClick={onRemove}>\n            <AiFillCloseCircle className='remove-icon' />\n            <span className='remove-text'>Remove</span>\n          </button>\n        </li>\n      )\n    }}\n  </CartContext.Consumer>\n)\n\nexport default CartItem\n","import './index.css'\n\nconst EmptyCartView = () => (\n  <div className='empty-cart-container'>\n    <img\n      src='https://assets.ccbp.in/frontend/react-js/nxt-trendz-empty-cart-img.png'\n      alt='empty cart'\n      className='empty-cart-image'\n    />\n    <h1 className='empty-heading'>Your Cart Is Empty</h1>\n  </div>\n)\n\nexport default EmptyCartView\n","import Header from '../Header'\nimport CartItem from '../CartItem'\nimport EmptyCartView from '../EmptyCartView'\nimport CartContext from '../../context/CartContext'\nimport './index.css'\n\nconst Cart = () => (\n  <CartContext.Consumer>\n    {value => {\n      const {cartList, removeAllCartItems} = value\n      const isCartEmpty = cartList.length === 0\n\n      return (\n        <div className='cart-route-container'>\n          <Header />\n          <div className='cart-body-container'>\n            {isCartEmpty ? (\n              <EmptyCartView />\n            ) : (\n              <div className='cart-content-container'>\n                <div className='cart-header-action'>\n                  <h1 className='cart-main-heading'>Cart Items</h1>\n                  <button\n                    type='button'\n                    className='remove-all-btn'\n                    onClick={removeAllCartItems}\n                  >\n                    Remove All\n                  </button>\n                </div>\n                <ul className='cart-items-list'>\n                  {cartList.map(item => (\n                    <CartItem key={item.dish_id} cartItemDetails={item} />\n                  ))}\n                </ul>\n              </div>\n            )}\n          </div>\n        </div>\n      )\n    }}\n  </CartContext.Consumer>\n)\n\nexport default Cart\n","import {Route, Redirect} from 'react-router-dom'\nimport Cookies from 'js-cookie'\n\nconst ProtectedRoute = props => {\n  const token = Cookies.get('jwt_token')\n  if (token === undefined) {\n    return <Redirect to='/login' />\n  }\n  return <Route {...props} />\n}\n\nexport default ProtectedRoute\n","import {Component} from 'react'\nimport {BrowserRouter, Route, Switch, Redirect} from 'react-router-dom'\nimport CartContext from './context/CartContext'\nimport Login from './components/Login'\nimport Home from './components/Home'\nimport Cart from './components/Cart'\nimport ProtectedRoute from './components/ProtectedRoute'\nimport './App.css'\n\nclass App extends Component {\n  state = {\n    cartList: [],\n  }\n\n  removeAllCartItems = () => {\n    this.setState({cartList: []})\n  }\n\n  addCartItem = dishItem => {\n    const {cartList} = this.state\n    const existingItem = cartList.find(\n      item => item.dish_id === dishItem.dish_id,\n    )\n\n    if (existingItem) {\n      this.setState(prevState => ({\n        cartList: prevState.cartList.map(item => {\n          if (item.dish_id === dishItem.dish_id) {\n            return {...item, quantity: item.quantity + dishItem.quantity}\n          }\n          return item\n        }),\n      }))\n    } else {\n      this.setState(prevState => ({\n        cartList: [...prevState.cartList, dishItem],\n      }))\n    }\n  }\n\n  removeCartItem = dishId => {\n    this.setState(prevState => ({\n      cartList: prevState.cartList.filter(item => item.dish_id !== dishId),\n    }))\n  }\n\n  incrementCartItemQuantity = dishId => {\n    this.setState(prevState => ({\n      cartList: prevState.cartList.map(item => {\n        if (item.dish_id === dishId) {\n          return {...item, quantity: item.quantity + 1}\n        }\n        return item\n      }),\n    }))\n  }\n\n  decrementCartItemQuantity = dishId => {\n    const {cartList} = this.state\n    const targetItem = cartList.find(item => item.dish_id === dishId)\n\n    if (targetItem && targetItem.quantity > 1) {\n      this.setState(prevState => ({\n        cartList: prevState.cartList.map(item => {\n          if (item.dish_id === dishId) {\n            return {...item, quantity: item.quantity - 1}\n          }\n          return item\n        }),\n      }))\n    } else {\n      this.removeCartItem(dishId)\n    }\n  }\n\n  render() {\n    const {cartList} = this.state\n\n    return (\n      <CartContext.Provider\n        value={{\n          cartList,\n          removeAllCartItems: this.removeAllCartItems,\n          addCartItem: this.addCartItem,\n          removeCartItem: this.removeCartItem,\n          incrementCartItemQuantity: this.incrementCartItemQuantity,\n          decrementCartItemQuantity: this.decrementCartItemQuantity,\n        }}\n      >\n        <BrowserRouter>\n          <Switch>\n            <Route exact path='/login' component={Login} />\n            <ProtectedRoute exact path='/' component={Home} />\n            <ProtectedRoute exact path='/cart' component={Cart} />\n            <Redirect to='/login' />\n          </Switch>\n        </BrowserRouter>\n      </CartContext.Provider>\n    )\n  }\n}\n\nexport default App\n","import React from 'react'\nimport ReactDOM from 'react-dom'\nimport App from './App'\n\nReactDOM.render(\n  <React.StrictMode>\n    <App />\n  </React.StrictMode>,\n  document.getElementById('root'),\n)\n"]}}